PORT=34343
DATABASE_URL=postgresql://USER:PASSWORD@192.168.3.14:5432/chamego_db
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
NODE_ENV=production
# Raw JSON or base64 service account, set in Portainer; never commit credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
REQUIRE_FCM=false
# Comma-separated allowed browser origins. Native Android does not require CORS.
CORS_ORIGINS=
# Trusted proxy CIDRs only, e.g. 192.168.3.0/24. Leave empty without a reverse proxy.
TRUST_PROXY=
